rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function profileExists(uid) {
      return exists(/databases/$(database)/documents/profiles/$(uid));
    }

    function isDriver() {
      return signedIn()
        && profileExists(request.auth.uid)
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'driver';
    }

    // New profiles may contain only app-owned fields. Approval must be
    // written by a privileged backend, never by a Rider or Partner client.
    function profileCreateFields() {
      return [
        'uid', 'role', 'fullName', 'phone', 'email',
        'vehicleType', 'vehicleNumber', 'vehicleModel',
        'createdAt', 'updatedAt'
      ];
    }

    function profileUpdateFields() {
      return [
        'fullName', 'phone', 'email',
        'vehicleType', 'vehicleNumber', 'vehicleModel',
        'updatedAt',
        'drivingLicenceNumber', 'drivingLicenceExpiryDate',
        'drivingLicenceSubmittedAt'
      ];
    }

    function licenceUpdateValid() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['drivingLicenceNumber', 'drivingLicenceExpiryDate',
          'drivingLicenceSubmittedAt'])
        || (
          resource.data.role == 'driver'
          && request.resource.data.drivingLicenceNumber is string
          && request.resource.data.drivingLicenceNumber.matches('^[A-Z0-9-]{8,25}$')
          && request.resource.data.drivingLicenceExpiryDate is timestamp
          && request.resource.data.drivingLicenceExpiryDate > request.time
          && request.resource.data.drivingLicenceSubmittedAt == request.time
        );
    }

    match /profiles/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role in ['rider', 'driver']
        && request.resource.data.keys().hasOnly(profileCreateFields());
      allow update: if isSelf(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(profileUpdateFields())
        && licenceUpdateValid();
      allow delete: if false;
    }

    // Verification records are created/updated only by privileged server
    // processes (Admin SDK bypasses these client rules). Partners can read
    // their own status but cannot create, approve, or alter review evidence.
    match /partnerVerifications/{uid} {
      allow get: if isSelf(uid);
      allow list, create, update, delete: if false;
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.uid == uid;
      allow delete: if false;

      match /devices/{deviceId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token == deviceId
          && request.resource.data.role in ['rider', 'driver']
          && request.resource.data.platform == 'android';
        allow delete: if isSelf(uid);
      }
    }

    match /riderTripPins/{uid} {
      allow get: if isSelf(uid);
      allow list: if false;
      allow create: if isSelf(uid)
        && request.resource.data.riderId == uid
        && request.resource.data.pin is string
        && request.resource.data.pin.matches('^[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['pin', 'riderId', 'createdAt']);
      allow update, delete: if false;
    }

    match /rideRequests/{rideId} {
      allow create: if signedIn()
        && request.resource.data.riderId == request.auth.uid
        && request.resource.data.status == 'requested'
        && request.resource.data.driverId == null
        && request.resource.data.pinRequired == true;

      allow get, list: if signedIn() && (
        resource.data.riderId == request.auth.uid
        || resource.data.driverId == request.auth.uid
        || (isDriver() && resource.data.status == 'requested')
      );

      // Riders may cancel before the trip starts, including after driver acceptance.
      allow update: if signedIn() && (
        (
          resource.data.riderId == request.auth.uid
          && resource.data.status in ['requested', 'accepted', 'arrived']
          && request.resource.data.status == 'cancelled'
          && (resource.data.status == 'requested'
              || request.resource.data.cancellationReason == 'Wrong pickup location')
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
            || (
              request.resource.data.cancelledBy == 'rider'
              && request.resource.data.cancellationReason in ['Changed my plans', 'Booked by mistake', 'Waiting too long', 'Wrong pickup location', 'No longer need the ride', 'Other reason']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancellationReason', 'cancelledBy'])
            )
          )
        )
        ||
        (
          resource.data.riderId == request.auth.uid
          && resource.data.status == 'completed'
          && request.resource.data.status == 'completed'
          && request.resource.data.riderRating is int
          && request.resource.data.riderRating >= 1
          && request.resource.data.riderRating <= 5
          && (
            request.resource.data.ratedAt is timestamp
            || request.resource.data.ratedAt == request.time
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['riderRating', 'ratedAt'])
        )
        ||
        (
          isDriver()
          && resource.data.status == 'requested'
          && resource.data.driverId == null
          && request.resource.data.status == 'accepted'
          && request.resource.data.driverId == request.auth.uid
          && resource.data.vehicle == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.vehicleType
          && request.resource.data.driverVehicleNumber is string
          && request.resource.data.driverVehicleNumber == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.vehicleNumber
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'driverId', 'driverVehicleNumber', 'acceptedAt'])
        )
        ||
        (
          isDriver()
          && resource.data.driverId == request.auth.uid
          && (
            (resource.data.status == 'accepted' && request.resource.data.status == 'arrived')
            || (resource.data.status == 'arrived' && request.resource.data.status == 'started'
              && exists(/databases/$(database)/documents/rideRequests/$(rideId)/pinVerification/verified))
            || (resource.data.status == 'started' && request.resource.data.status == 'completed')
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'arrivedAt', 'startedAt', 'completedAt'])
        )
      );

      match /pinVerification/{verificationId} {
        allow create: if verificationId == 'verified' && isDriver()
          && get(/databases/$(database)/documents/rideRequests/$(rideId)).data.driverId == request.auth.uid
          && get(/databases/$(database)/documents/rideRequests/$(rideId)).data.status == 'arrived'
          && request.resource.data.driverId == request.auth.uid
          && request.resource.data.keys().hasOnly(['pin', 'driverId', 'verifiedAt'])
          && request.resource.data.pin == get(/databases/$(database)/documents/riderTripPins/$(get(/databases/$(database)/documents/rideRequests/$(rideId)).data.riderId)).data.pin;
        allow get: if signedIn() && get(/databases/$(database)/documents/rideRequests/$(rideId)).data.driverId == request.auth.uid;
        allow list, update, delete: if false;
      }
      allow delete: if false;
    }

    match /paymentReceipts/{rideId} {
      allow get: if signedIn() && (
        resource.data.riderId == request.auth.uid
        || resource.data.driverId == request.auth.uid
      );
      allow list, create, update, delete: if false;
    }

    // Evidence attestations and reviewer authorizations are server-only.
    // Firebase Admin SDK bypasses client security rules; access must be enforced
    // by trusted backend logic and IAM, never by client-written flags.
    match /partnerReviewEvidence/{evidenceId} {
      allow read, write: if false;
    }

    match /partnerReviewers/{reviewerUid} {
      allow read, write: if false;
    }

    // Online authorization grants are backend-owned and must not be forged
    // or read as an alternative to server-side eligibility checks.
    // Deletion requests contain private account and workflow information.
    // Only trusted server processes may create, read or change them.
    match /accountDeletionRequests/{uid} {
      allow read, write: if false;
    }

    match /partnerActiveRideLocks/{uid} {
      allow read, write: if false;
    }

    // Deletion requests contain privacy intent and are only created by a
    // trusted authenticated backend; never expose the queue to clients.
    match /accountDeletionRequests/{uid} {
      allow read, write: if false;
    }

    match /partnerOnlineAuthorizations/{uid} {
      allow read, write: if false;
    }

    match /partnerReviewAudit/{auditId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
