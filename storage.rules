rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Only the owner's registration certificate image may be uploaded.
    match /partnerDocuments/{uid}/registrationCertificate {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validRcImage() {
        return request.resource.size > 0
          && request.resource.size <= 5 * 1024 * 1024
          && request.resource.contentType in ['image/jpeg', 'image/png'];
      }
      allow get: if owner();
      allow create, update: if owner() && validRcImage();
      allow delete, list: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
