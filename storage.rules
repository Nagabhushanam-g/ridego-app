rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Documents are private to their authenticated owner.
    // Never expose these documents publicly or allow arbitrary paths.
    match /partnerDocuments/{uid}/{documentType} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function allowedDocument() {
        return documentType in [
          'drivingLicence', 'registrationCertificate', 'insurance', 'permit'
        ];
      }
      function validUpload() {
        return request.resource.size > 0
          && request.resource.size <= 5 * 1024 * 1024
          && request.resource.contentType in [
            'application/pdf', 'image/jpeg', 'image/png'
          ];
      }
      allow get: if owner() && allowedDocument();
      allow create, update: if owner() && allowedDocument() && validUpload();
      allow delete: if false;
      allow list: if false;
    }
  }
}
